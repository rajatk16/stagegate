{
  "name": "stagegate",
  "version": "0.0.0",
  "description": "StageGate - Multi-tenant CFP and conference review management platform",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.19.0 <12.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@stagegate/web",
    "dev:api": "turbo run dev --filter=@stagegate/api",
    "dev:worker": "turbo run dev --filter=@stagegate/worker",
    "dev:admin": "turbo run dev --filter=@stagegate/admin",
    "build": "turbo run build",
    "lint": "npm run lint:root && turbo run lint",
    "lint:root": "eslint eslint.config.mjs prettier.config.mjs scripts packages/eslint-config --max-warnings=0",
    "lint:fix": "npm run lint:root:fix && turbo run lint:fix",
    "lint:root:fix": "eslint eslint.config.mjs prettier.config.mjs scripts packages/eslint-config --fix --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate:workspaces && npm run format:check && npm run lint:root && turbo run lint typecheck build",
    "clean": "node scripts/clean.mjs",
    "validate:workspaces": "node scripts/validate-workspaces.mjs",
    "graph": "turbo run build --graph",
    "info": "turbo info",
    "build:web": "turbo run build --filter=@stagegate/web",
    "preview:web": "npm run preview --workspace=@stagegate/web",
    "build:api": "turbo run build --filter=@stagegate/api",
    "start:api": "npm run start:prod --workspace=@stagegate/api",
    "firebase:emulators": "firebase emulators:start --config infrastructure/firebase/firebase.json --project demo-stagegate --only auth,firestore",
    "firebase:emulators:seeded": "firebase emulators:start --config infrastructure/firebase/firebase.json --project demo-stagegate --only auth,firestore --import infrastructure/firebase/.emulator-data --export-on-exit infrastructure/firebase/.emulator-data",
    "firebase:export": "firebase emulators:export infrastructure/firebase/.emulator-data --config infrastructure/firebase/firebase.json --project demo-stagegate --force",
    "check:infrastructure": "npm run check",
    "build:packages": "turbo run build --filter=@stagegate/contracts --filter=@stagegate/apiClient",
    "docker:config": "docker compose config --quiet",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose up --build --watch",
    "docker:up:detached": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:watch": "docker compose watch",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "docker:prod:config": "docker compose -f compose.production.yaml config --quiet",
    "docker:prod:build": "docker compose -f compose.production.yaml build",
    "docker:prod:up": "docker compose -f compose.production.yaml up -d --wait",
    "docker:prod:down": "docker compose -f compose.production.yaml down",
    "docker:prod:logs": "docker compose -f compose.production.yaml logs -f"
  },
  "devDependencies": {
    "@stagegate/apiClient": "*",
    "@stagegate/contracts": "*",
    "@stagegate/eslint-config": "*",
    "@stagegate/typescript-config": "*",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "firebase-tools": "15.36.0",
    "prettier": "3.7.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
