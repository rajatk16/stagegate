{
  "name": "stagegate",
  "version": "0.0.0",
  "description": "StageGate - Multi-tenant CFP and conference review management platform",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.6.2 <12.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@stagegate/web",
    "dev:api": "turbo run dev --filter=@stagegate/api",
    "dev:worker": "turbo run dev --filter=@stagegate/worker",
    "dev:admin": "turbo run dev --filter=@stagegate/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "npm run test:foundation && turbo run test",
    "test:foundation": "node --test scripts/tests/*.test.mjs",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "check": "npm run validate:workspaces && npm run test:foundation && turbo run lint typecheck test build",
    "clean": "node scripts/clean.mjs",
    "validate:workspaces": "node scripts/validate-workspaces.mjs",
    "graph": "turbo run build --graph",
    "info": "turbo info"
  },
  "devDependencies": {
    "turbo": "2.5.8"
  }
}
