{
  "name": "stagegate",
  "version": "0.0.0",
  "description": "StageGate - Multi-tenant CFP and conference review management platform",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.19.0 <12.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@stagegate/web",
    "dev:api": "turbo run dev --filter=@stagegate/api",
    "dev:worker": "turbo run dev --filter=@stagegate/worker",
    "dev:admin": "turbo run dev --filter=@stagegate/admin",
    "build": "turbo run build",
    "lint": "npm run lint:root && turbo run lint",
    "lint:root": "eslint eslint.config.mjs prettier.config.mjs scripts packages/eslint-config --max-warnings=0",
    "lint:fix": "npm run lint:root:fix && turbo run lint:fix",
    "lint:root:fix": "eslint eslint.config.mjs prettier.config.mjs scripts packages/eslint-config --fix --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:foundation && turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "check": "npm run validate:workspaces && npm run format:check && npm run lint:root && npm run test:foundation && turbo run lint typecheck test build && turbo run test:integration",
    "clean": "node scripts/clean.mjs",
    "validate:workspaces": "node scripts/validate-workspaces.mjs",
    "graph": "turbo run build --graph",
    "info": "turbo info",
    "build:web": "turbo run build --filter=@stagegate/web",
    "preview:web": "npm run preview --workspace=@stagegate/web",
    "test:web": "turbo run test --filter=@stagegate/web",
    "test:web:watch": "npm run test:watch --workspace=@stagegate/web",
    "test:web:coverage": "turbo run test:coverage --filter=@stagegate/web",
    "test:coverage": "turbo run test:coverage",
    "build:api": "turbo run build --filter=@stagegate/api",
    "start:api": "npm run start:prod --workspace=@stagegate/api",
    "test:api": "turbo run test --filter=@stagegate/api",
    "test:api:watch": "npm run test:watch --workspace=@stagegate/api",
    "test:api:coverage": "turbo run test:coverage --filter=@stagegate/api",
    "test:api:integration": "turbo run test:integration --filter=@stagegate/api",
    "firebase:emulators": "firebase emulators:start --config infrastructure/firebase/firebase.json --project demo-stagegate --only auth,firestore",
    "firebase:emulators:seeded": "firebase emulators:start --config infrastructure/firebase/firebase.json --project demo-stagegate --only auth,firestore --import infrastructure/firebase/.emulator-data --export-on-exit infrastructure/firebase/.emulator-data",
    "firebase:export": "firebase emulators:export infrastructure/firebase/.emulator-data --config infrastructure/firebase/firebase.json --project demo-stagegate --force",
    "firebase:test": "firebase emulators:exec --config infrastructure/firebase/firebase.json --project demo-stagegate --only auth,firestore \"npm run test:firebase --workspace=@stagegate/api\"",
    "test:api:firebase": "npm run firebase:test",
    "check:infrastructure": "npm run check && npm run firebase:test",
    "build:packages": "turbo run build --filter=@stagegate/contracts --filter=@stagegate/apiClient",
    "test:contracts": "turbo run test --filter=@stagegate/contracts",
    "test:apiClient": "turbo run test --filter=@stagegate/apiClient",
    "test:packages": "turbo run test --filter=@stagegate/contracts --filter=@stagegate/apiClient",
    "test:interop": "npm run build:packages && node --test scripts/tests/package-interop.test.mjs",
    "test:foundation": "npm run build:packages && node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@stagegate/apiClient": "*",
    "@stagegate/contracts": "*",
    "@stagegate/eslint-config": "*",
    "@stagegate/typescript-config": "*",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "firebase-tools": "15.36.0",
    "prettier": "3.7.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
