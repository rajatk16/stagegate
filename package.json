{
  "name": "stagegate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:all": "npm run test && npm run test:integration",
    "typecheck:test": "turbo run typecheck:test",
    "prepare": "husky",
    "test:e2e": "turbo run test:e2e",
    "build:api": "turbo run build --filter=@stagegate/api",
    "build:worker": "turbo run build --filter=@stagegate/worker",
    "check:backend": "turbo run lint typecheck typecheck:test test build --filter=@stagegate/api --filter=@stagegate/worker --filter=@stagegate/backend-platform --filter=@stagegate/backend-testkit",
    "test:integration:backend": "turbo run test:integration --filter=@stagegate/api --filter=@stagegate/worker",
    "test:integration:backend:emulators": "firebase emulators:exec --project stagegate-test --only auth,firestore,storage \"npm run test:integration:backend\"",
    "container:build:api": "docker build --file Dockerfile.backend --build-arg SERVICE=api --tag stagegate-api:local .",
    "container:build:worker": "docker build --file Dockerfile.backend --build-arg SERVICE=worker --tag stagegate-worker:local .",
    "emulators:start": "firebase emulators:start --project demo-stagegate-local --only auth,firestore,storage",
    "emulators:check": "node packages/backend-platform/scripts/checkEmulators.mjs",
    "emulators:verify": "firebase emulators:exec --project demo-stagegate-local --only auth,firestore,storage \"npm run emulators:check\""
  },
  "devDependencies": {
    "eslint": "^10.0.1",
    "firebase-tools": "15.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.4",
    "turbo": "^2.10.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,css,md,html,yml,yaml}": "prettier --write"
  }
}
