{
  "name": "with-vite-react",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-stagegate",
    "check:api": "npm run check --workspace api",
    "typecheck:web": "npm run typecheck --workspace web",
    "lint:web": "npm run lint --workspace web",
    "build:web": "npm run build --workspace web",
    "preview:web": "npm run preview --workspace web",
    "check:web": "npm run check --workspace web"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "eslint": "10.9.1",
    "firebase-tools": "^15.30.2",
    "prettier": "3.9.6",
    "turbo": "^2.11.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
