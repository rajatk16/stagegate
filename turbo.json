{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "VITE_API_BASE_URL",
        "VITE_FIREBASE_PROJECT_ID",
        "VITE_FIREBASE_AUTH_EMULATOR_URL"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "VITE_API_BASE_URL",
        "VITE_FIREBASE_PROJECT_ID",
        "VITE_FIREBASE_AUTH_EMULATOR_URL"
      ]
    }
  }
}
