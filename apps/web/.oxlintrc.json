{
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "globals": {
    "__APP_VERSION__": "readonly"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["vite.config.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ]
}
