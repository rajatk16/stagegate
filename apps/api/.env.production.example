NODE_ENV=production

APP_NAME=StageGate API
APP_VERSION=0.0.0

HOST=0.0.0.0
PORT=4000

CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=false

HTTP_BODY_LIMIT=1mb

SWAGGER_ENABLED=false

FIREBASE_MODE=cloud
FIREBASE_PROJECT_ID=your-stagegate-production-project

FIREBASE_HEALTH_TIMEOUT_MS=2000
FIREBASE_HEALTH_CACHE_TTL_MS=5000
