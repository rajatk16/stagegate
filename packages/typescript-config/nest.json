{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./node.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "verbatimModuleSyntax": false,

    "strictPropertyInitialization": true,

    "removeComments": true,

    "declaration": false,
    "declarationMap": false,

    "noEmitOnError": true
  }
}
