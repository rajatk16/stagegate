{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "verbatimModuleSyntax": true,

    "types": ["node"],

    "sourceMap": true,
    "inlineSources": true,

    "declaration": false,
    "declarationMap": false,

    "noEmitOnError": true
  }
}
